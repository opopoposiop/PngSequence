<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PngSequenceAvi</AssemblyName>
    <RootNamespace>PngSequenceAvi</RootNamespace>
    <Version>1.3.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\vendor\ffmpeg\ffmpeg.exe"
                      LogicalName="PngSequenceAvi.ffmpeg.exe" />
  </ItemGroup>

  <Target Name="EnsureEmbeddedFfmpeg" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\vendor\ffmpeg\ffmpeg.exe')"
           Text="同梱FFmpegがありません。powershell -ExecutionPolicy Bypass -File .\src\prepare-ffmpeg.ps1 を実行してください。" />
  </Target>
</Project>
